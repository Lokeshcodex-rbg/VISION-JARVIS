# VISION / JARVIS — Configuration Template
# Copy this file to .env and configure your environment variables.
# Do not commit your real .env file or private credentials to version control.

# Server Configuration
PORT=3000

# AI Model Provider: "gemini" | "ollama" | "local"
# When set to "gemini", cloud conversational inference and tool calling are enabled.
# When set to "local", the application runs 100% offline using local engines.
AI_PROVIDER=gemini

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM Fallback (Optional, e.g., Ollama for offline use)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Desktop Companion Preferences
HIDE_WHEN_IDLE=true
STARTUP_WITH_WINDOWS=false
ALWAYS_ON_TOP=false

# Speech Synthesis (Optional, Web Speech API is used by default)
# Configurable endpoints for external speech synthesis engines if installed.
SPEECH_SYNTHESIS_ENABLED=true
